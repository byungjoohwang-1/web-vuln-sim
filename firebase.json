{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/ai",
        "function": "aiProxy"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|eot|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(ico|svg|png|jpg|jpeg|gif|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=60, must-revalidate"
          }
        ]
      },
      {
        "_comment": "모의 증거 로그는 합성 고정 자료(파일당 48,000건, 원본 9~27MB)다. 위의 일반 js 규칙(max-age=60)에 걸리면 사건 패널을 다시 열 때마다 수 MB 를 재전송한다. 내용이 바뀌지 않으므로 길게 캐시한다. 같은 키는 뒤 규칙이 우선한다.",
        "source": "/data/evidence/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "predeploy": [
      "node \"$RESOURCE_DIR/../tools/predeploy-check.js\""
    ],
    "redirects": [
      {
        "source": "/03_code_hardedcode.html",
        "destination": "/03_code_hardcoded_credentials.html",
        "type": 301
      },
      {
        "source": "/sim-hardedcode.html",
        "destination": "/sim-hardcoded-credentials.html",
        "type": 301
      },
      {
        "source": "/03_code_inapporiate_auth.html",
        "destination": "/03_code_inappropriate_auth.html",
        "type": 301
      },
      {
        "source": "/sim-test.html",
        "destination": "/vuln-hub.html",
        "type": 301
      },
      {
        "source": "/config.js",
        "destination": "/index.html",
        "type": 301
      },
      {
        "source": "/privacy.html",
        "destination": "/privacy-policy.html",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
