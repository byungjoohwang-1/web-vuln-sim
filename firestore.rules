rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각 사용자는 자신의 진도 문서(users/{uid})만 읽고 쓸 수 있다.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 콘텐츠 보호(IP): 로그인한 사용자만 문제은행 읽기 가능, 쓰기는 콘솔/관리자만.
    match /content/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // 리더보드: 로그인자만 순위 조회. 쓰기는 서버(Admin SDK)만.
    // [QA-P0-05] 이전에는 "본인 문서면 쓰기 허용"이었는데, 이는 타인 위조만 막을 뿐
    // 본인이 임의 점수·레벨을 기록하는 것을 전혀 막지 못했다. 검증된 시험 결과만
    // Cloud Functions(certApi)가 기록하도록 클라이언트 쓰기를 전면 차단한다.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // 검증된 수료증: 단건 공개 조회(제3자 검증)만 허용. 생성·수정·삭제는 서버만.
    // [QA-P0-05] 이전에는 클라이언트가 uid만 맞추면 임의 점수·날짜·해시로 생성할 수 있었다.
    // 이제 발급은 certApi(서버 채점 + HMAC 서명)에서만 이뤄진다. Admin SDK는 규칙을 우회한다.
    match /certificates/{certId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }
    // 자가 학습 기록(self-reported): 브라우저 진도 기반 기록은 "검증된 성취"와 분리해 보관한다.
    // 본인만 쓰기 가능하되, 이것은 자격 증명이 아니며 UI/검증 페이지에서 미검증으로 표시한다.
    match /selfCerts/{docId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind == 'self';
      allow update, delete: if false;
    }
    // 응시 횟수 카운터: 서버 전용(클라이언트가 읽거나 초기화할 수 없어야 한다).
    match /certAttempts/{docId} {
      allow read, write: if false;
    }
    // PvP 퀴즈 대전 방: 로그인자만 단건 조회(방 코드로 참가), 목록 열람 차단.
    // 방장은 본인 uid로 생성, 방장 또는 (본인을 guest로 설정하는)참가자만 갱신.
    // 각 플레이어는 players/{uid} 하위 문서에 본인 점수만 기록(상대 점수 위조 불가).
    match /matches/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.host == request.auth.uid
          || request.auth.uid == request.resource.data.guest);
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if false;
      }
    }
    // 무료 공개형 강의실: 로그인한 강사는 클래스를 만들고, 학생은 참여 코드로 조회 후 본인 진행률만 갱신한다.
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.instructorUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.instructorUid == request.auth.uid;

      match /members/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/classes/$(classId)).data.instructorUid == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/classes/$(classId)).data.instructorUid == request.auth.uid);
      }
    }
  }
}
