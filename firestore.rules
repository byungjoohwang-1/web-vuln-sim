rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각 사용자는 자신의 진도 문서(users/{uid})만 읽고 쓸 수 있다.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 콘텐츠 보호(IP): 로그인한 사용자만 문제은행 읽기 가능, 쓰기는 콘솔/관리자만.
    match /content/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // 리더보드: 로그인자만 순위 조회, 본인 문서만 갱신(점수 위조 방지 — 타인 문서 쓰기 불가).
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // 무료 공개형 강의실: 로그인한 강사는 클래스를 만들고, 학생은 참여 코드로 조회 후 본인 진행률만 갱신한다.
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.instructorUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.instructorUid == request.auth.uid;

      match /members/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/classes/$(classId)).data.instructorUid == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/classes/$(classId)).data.instructorUid == request.auth.uid);
      }
    }
  }
}
